# CNB 镜像定义（由 .cnb/workflows/build-image.yml 构建，构建上下文 = 仓库根目录）
#
# 基础镜像统一用 dtapps 维护的 alpine（https://github.com/dtapps/alpine）：
# CNB 侧从内部制品库拉 docker.cnb.cool/dtapp/alpine:latest，GitHub 侧从 GHCR 拉
# ghcr.io/dtapps/alpine:latest（见 .github/docker/Dockerfile.backend）。
# 两个 registry 由同一套上游流水线发布、标签契约一致，差异只在拉取地址。
# 两份 Dockerfile 都只负责「把静态编译好的二进制装进最小运行镜像」，
# 应用的启动参数、目录结构保持完全一致。
#
# 历史：这份原先放在 cmd/backend/Dockerfile（已删除），其 COPY 写的是 `../../bin/...`，
# 以仓库根目录为构建上下文时属于「路径超出上下文」，Docker 会直接拒绝；搬家时一并修正为 bin/。

FROM docker.cnb.cool/dtapp/alpine:latest

# tzdata：Go 程序要靠系统时区库才能让 TZ=Asia/Shanghai 真正生效
# ca-certificates：上报/通知走 HTTPS 时需要根证书
RUN apk add --no-cache tzdata ca-certificates

WORKDIR /app

# CGO_ENABLED=0 静态编译产物，由 build-image.yml 中的 make build-linux-amd64 生成
COPY bin/backend-linux-amd64 /app/ip_vibe

RUN mkdir -p /app/data/ /app/logs/ \
    && chmod +x /app/ip_vibe

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8

# 构建时参数：不传即为空字符串
ARG DEBUG
ARG HTTP_PORT
ARG BASIC_AUTH_USERNAME
ARG BASIC_AUTH_PASSWORD
ARG DEVICE_CODE
ARG DEVICE_NAME

ENV DEBUG=${DEBUG} \
    HTTP_PORT=${HTTP_PORT} \
    BASIC_AUTH_USERNAME=${BASIC_AUTH_USERNAME} \
    BASIC_AUTH_PASSWORD=${BASIC_AUTH_PASSWORD} \
    DEVICE_CODE=${DEVICE_CODE} \
    DEVICE_NAME=${DEVICE_NAME}

ENTRYPOINT ["/app/ip_vibe"]