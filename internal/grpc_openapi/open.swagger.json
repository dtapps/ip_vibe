{
  "swagger": "2.0",
  "info": {
    "title": "包名",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "OpenService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/device/ip-report": {
      "post": {
        "summary": "设备上报IP",
        "operationId": "OpenService_ReportDeviceIP",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/openReportDeviceIPResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/openReportDeviceIPRequest"
            }
          }
        ],
        "tags": [
          "OpenService"
        ]
      }
    },
    "/device/{deviceCode}/port-forwards": {
      "get": {
        "summary": "获取设备端口转发",
        "operationId": "OpenService_GetDevicePortForwards",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/openGetDevicePortForwardsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "deviceCode",
            "description": "设备编码",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OpenService"
        ]
      }
    },
    "/device/{deviceCode}/port-forwards/{portForwardId}/stats": {
      "post": {
        "summary": "创建端口转发统计信息",
        "operationId": "OpenService_CreatePortForwardStats",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "deviceCode",
            "description": "设备编码",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "portForwardId",
            "description": "端口转发ID",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OpenServiceCreatePortForwardStatsBody"
            }
          }
        ],
        "tags": [
          "OpenService"
        ]
      }
    },
    "/setting": {
      "get": {
        "summary": "获取配置",
        "operationId": "OpenService_GetSetting",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/openGetSettingResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "OpenService"
        ]
      }
    }
  },
  "definitions": {
    "OpenServiceCreatePortForwardStatsBody": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "format": "int64",
          "title": "转发实例启动时间 (UTC)"
        },
        "activeConn": {
          "type": "string",
          "format": "int64",
          "title": "TCP 活跃连接 / UDP session"
        },
        "totalConn": {
          "type": "string",
          "format": "int64",
          "title": "TCP 累计连接"
        },
        "bytesIn": {
          "type": "string",
          "format": "int64",
          "title": "入站流量"
        },
        "bytesOut": {
          "type": "string",
          "format": "int64",
          "title": "出站流量"
        },
        "udpPacketsIn": {
          "type": "string",
          "format": "int64",
          "title": "入站 UDP 包数"
        },
        "udpPacketsOut": {
          "type": "string",
          "format": "int64",
          "title": "出站 UDP 包数"
        },
        "errors": {
          "type": "string",
          "format": "int64",
          "title": "错误数"
        }
      },
      "title": "创建端口转发统计信息 请求参数"
    },
    "openGetDevicePortForwardsResponse": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/openPortForwardRule"
          },
          "title": "端口转发规则列表"
        }
      },
      "title": "获取设备端口转发 响应参数"
    },
    "openGetSettingResponse": {
      "type": "object",
      "properties": {
        "IPReportIntervalTime": {
          "type": "string",
          "title": "IP上报间隔时间"
        },
        "PortForwardReloadTime": {
          "type": "string",
          "title": "端口转发重载时间"
        },
        "PortForwardReportTime": {
          "type": "string",
          "title": "端口转发统计上报时间"
        }
      },
      "title": "获取配置 响应参数"
    },
    "openPortForwardRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64",
          "title": "设备端口转发序号"
        },
        "localPort": {
          "type": "integer",
          "format": "int32",
          "title": "本地监听端口"
        },
        "remoteHost": {
          "type": "string",
          "title": "远程目标地址"
        },
        "remotePort": {
          "type": "integer",
          "format": "int32",
          "title": "远程目标端口"
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "协议列表，支持 tcp4, tcp6, udp4, udp6"
        },
        "autoForward": {
          "type": "boolean",
          "title": "防火墙自动放行"
        }
      },
      "title": "端口转发规则列表"
    },
    "openReportDeviceIPRequest": {
      "type": "object",
      "properties": {
        "deviceCode": {
          "type": "string",
          "title": "设备编码"
        },
        "deviceName": {
          "type": "string",
          "title": "设备名称"
        },
        "ipv4Addr": {
          "type": "string",
          "title": "IP地址V4"
        },
        "ipv6Addr": {
          "type": "string",
          "title": "IP地址V6"
        }
      },
      "title": "设备上报IP 请求参数"
    },
    "openReportDeviceIPResponse": {
      "type": "object",
      "properties": {
        "msg": {
          "type": "string",
          "title": "消息"
        }
      },
      "title": "设备上报IP 响应参数"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
