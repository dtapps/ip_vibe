// OrderIf 动态地添加一个 ORDER 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Order 列表
func (qb *{{ $n.Name }}Query) OrderIf(condition bool, o ...{{ $n.Package }}.OrderOption) *{{ $n.Name }}Query {
	if condition {
		qb.Order(o...)
	}
	return qb
}

