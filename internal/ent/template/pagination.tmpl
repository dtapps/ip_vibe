// PaginationResult 表示分页查询的结果。
// 包含当前页数据、总数、页码和每页大小，便于前端直接使用。
type PaginationResult[T any] struct {
	Items []*T  `json:"items"`   // 当前页的记录列表
	Total int64 `json:"total"`   // 满足条件的总记录数
	Page  int   `json:"page"`    // 当前页码（从1开始）
	Size  int   `json:"size"`    // 每页记录数
}

{{ range $n := $.Nodes }}

// Paginate 对当前查询执行分页操作。
// 参数 page 和 size 必须为正整数；若传入非法值，将自动修正：
//   - page < 1 时默认为 1
//   - size < 1 时默认为 20
//   - size > 1000 时限制为 1000（防止数据库压力过大）
// 注意：Total 是通过额外执行 Count() 查询获得的，对大表可能有性能开销。
func (q *{{ $n.Name }}Query) Paginate(ctx context.Context, page, size int) (*PaginationResult[{{ $n.Name }}], error) {
    q.log("Paginate: page=", page, ", size=", size)
	if page < 1 {
		page = 1
	}
	if size < 1 {
		size = 20
	}
	if size > 1000 {
		size = 1000 // 安全上限，防止 OOM 或慢查询
	}

	offset := (page - 1) * size

	// 先获取总数量
	total, err := q.Clone().Count(ctx)
	if err != nil {
		return nil, err
	}

	// 再获取当前页数据
	items, err := q.Clone().Offset(offset).Limit(size).All(ctx)
	if err != nil {
		return nil, err
	}

	return &PaginationResult[{{ $n.Name }}]{
		Items: items,
		Total: int64(total),
		Page:  page,
		Size:  size,
	}, nil
}

