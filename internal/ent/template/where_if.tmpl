{{ define "where_if" }}

{{/* 以下行告诉IntelliJ/GoLand启用基于*gen.Graph类型的自动完成 */}}
{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

{{ range $n := $.Nodes }}

// WhereIf 动态地添加一个 WHERE 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Where 列表
func (q *{{ $n.Name }}Query) WhereIf(condition bool, p predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
	{{- /* if q.debug { */}}
    q.log("WhereIf: condition=", condition, ", predicate=", fmt.Sprintf("%#v", p))
    {{- /* } */}}
	if condition {
		q.Where(p)
	}
	return q
}

// WhereIfs 动态地添加一个 WHERE 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Where 列表
func (q *{{ $n.Name }}Query) WhereIfs(condition bool, p ...predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
	{{- /* if q.debug { */}}
    q.log("WhereIfs: condition=", condition, ", predicates=", fmt.Sprintf("%#v", p))
    {{- /* } */}}
	if condition {
		q.Where(p...)
	}
	return q
}

// WhereIfFunc 动态地添加一个 WHERE 子句到查询构建器。
// conditionFunc 决定是否应用过滤。
// predicateFunc 只有在 conditionFunc 返回 true 时才会被调用。
func (q *{{ $n.Name }}Query) WhereIfFunc(condition bool, predicateFunc func() predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
    {{- /* if q.debug { */}}
    q.log("WhereIfFunc: condition=", condition, ", hasPredicate=", predicateFunc != nil)
    {{- /* } */}}
    if condition {
        q.Where(predicateFunc()) 
    }
    return q
}
{{ end }}

