{{ define "query_gorm_compat" }}

{{/* gotype: entgo.io/ent/entc/gen.Graph */}}
{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

import (
	"context"
	"fmt"
)

{{ range $n := $.Nodes }}
{{ $queryName := printf "%sQuery" $n.Name }}
{{ $nodeName := $n.Name }}
{{ $table := $n.Name | lower }}

// Take 获取任意一条记录（不保证顺序），等价于 LIMIT 1。
// 行为与 GORM 的 Take(ctx) 一致：不添加 ORDER，仅限制结果为 1 行。
func (q *{{ $queryName }}) Take(ctx context.Context) (*{{ $nodeName }}, error) {
	return q.Limit(1).First(ctx)
}

// Last 获取最后一条记录，按主键降序排列（ORDER BY id DESC LIMIT 1）。
// 行为与 GORM 的 Last(ctx) 一致。
// 仅当实体启用了默认 ID（即未设置 ID(false)）时可用。
func (q *{{ $queryName }}) Last(ctx context.Context) (*{{ $nodeName }}, error) {
	{{- if $n.ID }}
		// 使用默认主键 "id"
		return q.Order({{ $table }}.ByID(sql.OrderDesc())).First(ctx)
	{{- else }}
		// 未启用默认 ID（可能是复合主键或自定义主键），无法安全定义“最后一条”
		return nil, fmt.Errorf("{{ $nodeName }} has no default 'id' primary key; Last() is unsupported")
	{{- end }}
}

// Find 获取所有匹配的记录。
// 行为类比 GORM 的 Find(ctx, &dest)，此处直接返回 []*T。
func (q *{{ $queryName }}) Find(ctx context.Context) ([]*{{ $nodeName }}, error) {
	return q.All(ctx)
}

{{ end }}

{{ end }}