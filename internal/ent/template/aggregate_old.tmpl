{{/* 通用聚合类型定义 */}}
type AggType string

const (
	SumAgg    AggType = "SUM"
	CountAgg  AggType = "COUNT"
	AvgAgg    AggType = "AVG"
	MaxAgg    AggType = "MAX"
	MinAgg    AggType = "MIN"
	StdDevAgg AggType = "STDDEV_POP"
)

{{ range $n := $.Nodes }}

// SumOrZero 计算某个字段的 SUM，返回 0 表示空值。
func (q *{{ $n.Name }}Query) SumOrZero(ctx context.Context, field string) (int64, error) {
	var res struct{ Val sql.NullInt64 }
	sel := q.Aggregate(
		func(s *sql.Selector) string {
			return fmt.Sprintf("COALESCE(SUM(%s),0) AS sum_val", s.C(field))
		},
	).Select("sum_val")
	if err := sel.Scan(ctx, &res); err != nil {
		return 0, err
	}
	if !res.Val.Valid {
		return 0, nil
	}
	return res.Val.Int64, nil
}

