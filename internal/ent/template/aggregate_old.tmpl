// AggregateOrZero 通用聚合方法，字段为空返回 0
func (q *{{ $n.Name }}Query) AggregateOrZero(ctx context.Context, aggType AggType, field string) (float64, error) {
	var res struct{ Val sql.NullFloat64 }

	sel := q.Aggregate(
		func(s *sql.Selector) string {
			var expr string
			if aggType == CountAgg {
				expr = "COUNT(*)" // COUNT 不用字段
			} else {
				expr = fmt.Sprintf("%s(%s)", aggType, s.C(field))
			}
			return fmt.Sprintf("COALESCE(%s,0) AS agg_val", expr)
		},
	).Select("agg_val")

	if err := sel.Scan(ctx, &res); err != nil {
		return 0, err
	}
	if !res.Val.Valid {
		return 0, nil
	}
	return res.Val.Float64, nil
}

