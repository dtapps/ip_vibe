{{ define "json_query" }}

{{/* 以下行告诉IntelliJ/GoLand启用基于*gen.Graph类型的自动完成 */}}
{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{/* 添加生成的文件的基头信息 */}}
{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

import (
    "fmt"
    "entgo.io/ent/dialect"
    "entgo.io/ent/dialect/sql"
)

{{ range $n := $.Nodes }}
    {{ range $f := $n.Fields }}
        {{ if $f.IsJSON }}
            {{- $baseFuncName := print "Where" $f.StructField "Contains" }}
            
            // {{ $baseFuncName }} 扩展了查询构建器，支持 JSON 数组的包含查询。
            // 自动适配 MySQL (JSON_CONTAINS), PostgreSQL (@>), SQLite (json_each)。
            func (q *{{ $n.Name }}Query) {{ $baseFuncName }}(val any) *{{ $n.Name }}Query {
                return q.Where(predicate.{{ $n.Name }}(func(s *sql.Selector) {
                    {{- /* 获取当前字段在数据库中的列名 */ -}}
                    column := {{ $n.Package }}.Field{{ $f.StructField }}

                    switch s.Dialect() {
                    case dialect.MySQL:
                        s.Where(sql.ExprP("JSON_CONTAINS(" + column + ", ?)", val))
                    case dialect.Postgres:
                        // PG 需要将值包装在数组格式内
                        s.Where(sql.ExprP(column + " @> ?", fmt.Sprintf("[%v]", val)))
                    case dialect.SQLite:
                        s.Where(sql.ExprP("EXISTS (SELECT 1 FROM json_each(" + column + ") WHERE value = ?)", val))
                    default:
                        // 兜底：模糊匹配
                        s.Where(sql.ExprP(column + " LIKE ?", fmt.Sprintf("%%\"%v\"%%", val)))
                    }
                }))
            }

            // {{ $baseFuncName }}If 只有在 condition 为 true 时才调用 {{ $baseFuncName }}。
            func (q *{{ $n.Name }}Query) {{ $baseFuncName }}If(condition bool, val any) *{{ $n.Name }}Query {
                if condition {
                    return q.{{ $baseFuncName }}(val)
                }
                return q
            }
        {{ end }}
    {{ end }}
{{ end }}

{{ end }}