{{ define "json_query" }}

{{/* 以下行告诉IntelliJ/GoLand启用基于*gen.Graph类型的自动完成 */}}
{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{/* 添加生成的文件的基头信息 */}}
{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

import (
    "fmt"
    "entgo.io/ent/dialect"
    "entgo.io/ent/dialect/sql"
)

{{ range $n := $.Nodes }}
    {{ range $f := $n.Fields }}
        {{ if $f.IsJSON }}
            {{- $baseFuncName := print "Where" $f.StructField "Contains" }}
            
            // {{ $baseFuncName }} 扩展了查询构建器，支持 JSON 数组的包含查询。
            // 自动适配 MySQL (JSON_CONTAINS), PostgreSQL (@>), SQLite (json_each)。
            func (q *{{ $n.Name }}Query) {{ $baseFuncName }}(val any) *{{ $n.Name }}Query {
                return q.Where(predicate.{{ $n.Name }}(func(s *sql.Selector) {
                    {{- /* 获取当前字段在数据库中的列名 */ -}}
                    column := {{ $n.Package }}.Field{{ $f.StructField }}

                    switch s.Dialect() {
                    case dialect.MySQL:
                        s.Where(sql.ExprP("JSON_CONTAINS(" + column + ", ?)", val))
                    case dialect.Postgres:
                        // PG 需要将值包装在数组格式内
                        s.Where(sql.ExprP(column + " @> ?", fmt.Sprintf("[%v]", val)))
                    case dialect.SQLite:
                        s.Where(sql.ExprP("EXISTS (SELECT 1 FROM json_each(" + column + ") WHERE value = ?)", val))
                    default:
                        // 兜底：模糊匹配
                        s.Where(sql.ExprP(column + " LIKE ?", fmt.Sprintf("%%\"%v\"%%", val)))
                    }
                }))
            }

            // {{ $baseFuncName }}If 只有在 condition 为 true 时才调用 {{ $baseFuncName }}。
            func (q *{{ $n.Name }}Query) {{ $baseFuncName }}If(condition bool, val any) *{{ $n.Name }}Query {
                if condition {
                    return q.{{ $baseFuncName }}(val)
                }
                return q
            }

			// {{ $baseFuncName }}FieldNotEmpty 判断 JSON 对象中指定路径的值存在且非空（非 null 且非空字符串）。
			// 支持嵌套路径：如 "user.profile.account_id" 会转换为 "$.user.profile.account_id"。
			// 安全提示：path 参数自动转义，防止 SQL 注入。
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldNotEmpty(path string) *{{ $n.Name }}Query {
				return q.Where(predicate.{{ $n.Name }}(func(s *sql.Selector) {
					column := {{ $n.Package }}.Field{{ $f.StructField }}
					jsonPath := buildJSONPath(path)

					switch s.Dialect() {
					case dialect.MySQL:
						// JSON_UNQUOTE 去引号后判断非空，同时校验非 NULL
						s.Where(sql.ExprP(
							"JSON_UNQUOTE(JSON_EXTRACT("+column+", ?)) != '' AND JSON_EXTRACT("+column+", ?) IS NOT NULL",
							jsonPath, jsonPath,
						))
					case dialect.Postgres:
						// ->> 提取文本，判断非 NULL 且非空字符串
						s.Where(sql.ExprP(
							"("+column+"->>? IS NOT NULL AND "+column+"->>? != '')",
							path, path,
						))
					case dialect.SQLite:
						// json_type 判断存在，同时排除空字符串（注意：SQLite 中空字符串为 '""'）
						s.Where(sql.ExprP(
							"(json_type("+column+", ?) IS NOT NULL AND json_extract("+column+", ?) NOT IN ('\"\"', ''))",
							jsonPath, jsonPath,
						))
					default:
						// 兜底：模糊匹配字段名+非空值（不精确，仅兼容）
						s.Where(sql.ExprP(column+" LIKE ?", fmt.Sprintf("%%\"%s\"%%", path)))
					}
				}))
			}

			// {{ $baseFuncName }}FieldNotEmptyIf 只有在 condition 为 true 时才调用 {{ $baseFuncName }}FieldNotEmpty。
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldNotEmptyIf(condition bool, path string) *{{ $n.Name }}Query {
				if condition {
					return q.{{ $baseFuncName }}FieldNotEmpty(path)
				}
				return q
			}

			// {{ $baseFuncName }}FieldEquals 按 JSON 路径精确匹配值（支持字符串/数字/布尔值）。
			// 示例：WhereConfigJSONFieldEquals("account_id", "000")
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldEquals(path string, val any) *{{ $n.Name }}Query {
				return q.Where(predicate.{{ $n.Name }}(func(s *sql.Selector) {
					column := {{ $n.Package }}.Field{{ $f.StructField }}
					jsonPath := buildJSONPath(path)

					// 将 val 转为 JSON 兼容字符串（数字/布尔值不加引号，字符串加引号）
					jsonVal := marshalJSONValue(val)

					switch s.Dialect() {
					case dialect.MySQL:
						s.Where(sql.ExprP("JSON_UNQUOTE(JSON_EXTRACT("+column+", ?)) = ?", jsonPath, jsonVal))
					case dialect.Postgres:
						s.Where(sql.ExprP(column+"->>? = ?", path, fmt.Sprintf("%v", val)))
					case dialect.SQLite:
						s.Where(sql.ExprP("json_extract("+column+", ?) = ?", jsonPath, jsonVal))
					default:
						// 兜底：模糊匹配（不推荐）
						s.Where(sql.ExprP(column+" LIKE ?", fmt.Sprintf("%%\"%s\":\"%v\"%%", path, val)))
					}
				}))
			}

			// {{ $baseFuncName }}FieldEqualsIf 只有在 condition 为 true 时才调用 {{ $baseFuncName }}FieldEquals。
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldEqualsIf(condition bool, path string, val any) *{{ $n.Name }}Query {
				if condition {
					return q.{{ $baseFuncName }}FieldEquals(path, val)
				}
				return q
			}

			// {{ $baseFuncName }}FieldExistsAndNotEmpty 判断 JSON 中指定路径的字段存在、非 null 且非空字符串。
			// 同时排除以下情况：
			//   - 字段不存在（如 {} 中查询 account_id）
			//   - 字段值为 null（如 {"account_id": null}）
			//   - 字段值为空字符串（如 {"account_id": ""}）
			// 支持嵌套路径：如 "user.profile.account_id"
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldExistsAndNotEmpty(path string) *{{ $n.Name }}Query {
				return q.Where(predicate.{{ $n.Name }}(func(s *sql.Selector) {
					column := {{ $n.Package }}.Field{{ $f.StructField }}
					jsonPath := "$." + strings.ReplaceAll(path, ".", ".") // 简单转义，实际建议用 buildJSONPath

					switch s.Dialect() {
					case dialect.MySQL:
						// 关键逻辑：
						// 1. JSON_EXTRACT(...) IS NOT NULL → 排除字段不存在 + 值为 null（经 UNQUOTE 后为 NULL）
						// 2. JSON_UNQUOTE(...) != '' → 排除空字符串
						// 注意：MySQL 中 JSON_EXTRACT(null_val) = "null" → UNQUOTE → NULL，因此 IS NOT NULL 可同时排除不存在和 null
						s.Where(sql.ExprP(
							"JSON_UNQUOTE(JSON_EXTRACT("+column+", ?)) IS NOT NULL AND JSON_UNQUOTE(JSON_EXTRACT("+column+", ?)) != ''",
							jsonPath, jsonPath,
						))

					case dialect.Postgres:
						// PG 中 ->> 对不存在字段和 null 值均返回 NULL，直接判断即可
						s.Where(sql.ExprP(
							"("+column+"->>? IS NOT NULL AND "+column+"->>? != '')",
							path, path,
						))

					case dialect.SQLite:
						// SQLite 特殊处理：
						// - 字段不存在 → json_extract = NULL
						// - 值为 null → json_extract = 'null' (字符串)
						// - 空字符串 → json_extract = '""'
						// 需同时排除这三种情况
						s.Where(sql.ExprP(
							"(json_extract("+column+", ?) IS NOT NULL AND json_extract("+column+", ?) NOT IN ('null', '\"\"', ''))",
							jsonPath, jsonPath,
						))

					default:
						// 兜底：模糊匹配（不精确，仅兼容）
						escapedPath := strings.ReplaceAll(path, `"`, `\"`)
						s.Where(sql.ExprP(column+" LIKE ?", fmt.Sprintf("%%\"%s\"%%", escapedPath)))
					}
				}))
			}

			// {{ $baseFuncName }}FieldExistsAndNotEmptyIf 条件版本
			func (q *{{ $n.Name }}Query) {{ $baseFuncName }}FieldExistsAndNotEmptyIf(condition bool, path string) *{{ $n.Name }}Query {
				if condition {
					return q.{{ $baseFuncName }}FieldExistsAndNotEmpty(path)
				}
				return q
			}
        {{ end }}
    {{ end }}
{{ end }}


// buildJSONPath 将点号路径转换为标准 JSON 路径（如 "user.name" → "$.user.name"）
// 自动处理字段名含特殊字符（如连字符）的情况：使用双引号包裹
func buildJSONPath(path string) string {
	parts := strings.Split(path, ".")
	for i, part := range parts {
		// 如果字段名含特殊字符（非字母数字下划线），用双引号包裹
		if strings.ContainsAny(part, "- ") || !regexp.MustCompile(`^[a-zA-Z0-9_]+$`).MatchString(part) {
			parts[i] = `"` + strings.ReplaceAll(part, `"`, `\"`) + `"`
		}
	}
	return "$." + strings.Join(parts, ".")
}

// marshalJSONValue 将 Go 值转为 JSON 字面量（用于 SQL 比较）
// 注意：此函数仅用于生成安全的字面量，实际查询应优先使用参数化
func marshalJSONValue(val any) string {
	switch v := val.(type) {
	case string:
		return `"` + strings.ReplaceAll(v, `"`, `\"`) + `"`
	case bool:
		return fmt.Sprintf("%v", v)
	case int, int8, int16, int32, int64, uint, uint8, uint16, uint32, uint64, float32, float64:
		return fmt.Sprintf("%v", v)
	default:
		// 兜底：转为字符串（可能不精确）
		return fmt.Sprintf("%v", v)
	}
}

{{ end }}