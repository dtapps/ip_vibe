{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

{{ range $n := $.Nodes }}

// OrderIf 动态地添加一个 ORDER 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Order 列表
func (q *{{ $n.Name }}Query) OrderIf(condition bool, o {{ $n.Package }}.OrderOption) *{{ $n.Name }}Query {
	{{- /* if q.debug { */}}
    q.log("OrderIf: condition=", condition, ", orderOption=", fmt.Sprintf("%#v", o))
    {{- /* } */}}
	if condition {
		q.Order(o)
	}
	return q
}

// OrderIfs 动态地添加一个 ORDER 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Order 列表
func (q *{{ $n.Name }}Query) OrderIfs(condition bool, o ...{{ $n.Package }}.OrderOption) *{{ $n.Name }}Query {
	{{- /* if q.debug { */}}
    q.log("OrderIfs: condition=", condition, ", orderOptions=", fmt.Sprintf("%#v", o))
    {{- /* } */}}
	if condition {
		q.Order(o...)
	}
	return q
}

{{ end }}

