{{ define "whereif" }}

{{/* gotype: entgo.io/ent/entc/gen.Graph */}}
{{/* 以下行告诉IntelliJ/GoLand启用基于*gen.Graph类型的自动完成 */}}

{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

{{ range $n := $.Nodes }}

// WhereIf 动态地添加一个 WHERE 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Where 列表
func (qb *{{ $n.Name }}Query) WhereIf(condition bool, p predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
	{{- /* if qb.debug { */}}
        fmt.Printf("WhereIf debug: condition=%t, predicate=%v\n", condition, p)
    {{- /* } */}}
	if condition {
		qb.Where(p)
	}
	return qb
}

// WhereIfs 动态地添加一个 WHERE 子句到查询构建器。
// 如果 condition 为 true，则应用给定的 Where 列表
func (qb *{{ $n.Name }}Query) WhereIfs(condition bool, p ...predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
	{{- /* if qb.debug { */}}
        fmt.Printf("WhereIfs debug: condition=%t, predicates=%v\n", condition, p)
    {{- /* } */}}
	if condition {
		qb.Where(p...)
	}
	return qb
}

// WhereIfFunc 动态地添加一个 WHERE 子句到查询构建器。
// conditionFunc 决定是否应用过滤。
// predicateFunc 只有在 conditionFunc 返回 true 时才会被调用。
func (qb *{{ $n.Name }}Query) WhereIfFunc(condition bool, predicateFunc func() predicate.{{ $n.Name }}) *{{ $n.Name }}Query {
    {{- /* if qb.debug { */}}
        fmt.Printf("WhereIfFunc debug: condition=%t, predicateFunc=%p\n", condition, predicateFunc)
    {{- /* } */}}
    if condition {
        qb.Where(predicateFunc()) 
    }
    return qb
}
{{ end }}

{{ end }}