// OrderBy{{ $f.StructField }}Desc 按字段 {{ $f.Name }} 降序排列查询结果。
// 降序排列表示从大到小的顺序，适用于时间字段（最新在前）、数值字段（最大在前）等场景。
// 返回值类型为 *{{ $n.Name }}Query，支持链式调用其他查询方法（如 Limit、Offset、Where 等）。
// 示例：
//   records, err := client.{{ $n.Name }}.Query().
//       OrderBy{{ $f.StructField }}Desc().
//       Limit(10).
//       All(ctx)
func (q *{{ $n.Name }}Query) OrderBy{{ $f.StructField }}Desc() *{{ $n.Name }}Query {
    return q.Order(Desc({{ $n.Package }}.Field{{ $f.StructField }}))
}

// OrderBy{{ $f.StructField }}Asc 按字段 {{ $f.Name }} 升序排列查询结果。
// 升序排列表示从小到大的顺序，适用于时间字段（最早在前）、数值字段（最小在前）等场景。
// 返回值类型为 *{{ $n.Name }}Query，支持链式调用其他查询方法。
// 示例：
//   records, err := client.{{ $n.Name }}.Query().
//       OrderBy{{ $f.StructField }}Asc().
//       All(ctx)
func (q *{{ $n.Name }}Query) OrderBy{{ $f.StructField }}Asc() *{{ $n.Name }}Query {
    return q.Order(Asc({{ $n.Package }}.Field{{ $f.StructField }}))
}

