// OrderByIDDesc 按主键 ID 降序排列查询结果。
// 降序排列表示从大到小的顺序，通常用于获取最新创建的记录（自增ID场景下）。
// 返回值类型为 *{{ $n.Name }}Query，支持链式调用其他查询方法（如 Limit、Offset、Where 等）。
// 示例：
//   records, err := client.{{ $n.Name }}.Query().
//       OrderByIDDesc().
//       Limit(10).
//       All(ctx)
func (q *{{ $n.Name }}Query) OrderByIDDesc() *{{ $n.Name }}Query {
    return q.Order(Desc({{ $n.Package }}.FieldID))
}

// OrderByIDAsc 按主键 ID 升序排列查询结果。
// 升序排列表示从小到大的顺序，通常用于按创建时间正序获取记录（自增ID场景下）。
// 返回值类型为 *{{ $n.Name }}Query，支持链式调用其他查询方法。
// 示例：
//   records, err := client.{{ $n.Name }}.Query().
//       OrderByIDAsc().
//       All(ctx)
func (q *{{ $n.Name }}Query) OrderByIDAsc() *{{ $n.Name }}Query {
    return q.Order(Asc({{ $n.Package }}.FieldID))
}

{{ end }}

