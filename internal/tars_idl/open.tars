module open {

    // 端口转发规则
    struct PortForwardRule {
        1  require int    id;              // 设备端口转发序号
        2  require int    local_port;        // 本地监听端口
        3  require string remote_host;      // 远程目标地址
        4  require int    remote_port;       // 远程目标端口
        5  require vector<string> protocols; // 协议列表：tcp4/tcp6/udp4/udp6
        6  require bool   auto_forward;     // 防火墙自动放行
    };

    // 设备上报IP 请求参数
    struct ReportDeviceIPRequest {
        1  require string device_code;      // 设备编码
        2  require string device_name;      // 设备名称
        3  require string ipv4_addr;       // IP地址V4
        4  require string ipv6_addr;       // IP地址V6
    };

    // 设备上报IP 响应参数
    struct ReportDeviceIPResponse {
        1  require string msg;             // 消息
    };

    // 获取设备端口转发 请求参数
    struct GetDevicePortForwardsRequest {
        1  require string device_code;      // 设备编码
    };

    // 获取设备端口转发 响应参数
    struct GetDevicePortForwardsResponse {
        1  require vector<PortForwardRule> rules; // 端口转发规则列表
    };

    // 创建端口转发统计信息 请求参数
    struct CreatePortForwardStatsRequest {
        1  require string device_code;       // 设备编码
        2  require long   port_forward_id;  // 转发ID
        3  require long   start_time;       // 启动时间(UTC，秒/毫秒由业务约定)
        4  require long   active_conn;      // TCP活跃连接 / UDP session
        5  require long   total_conn;       // TCP累计连接
        6  require long   bytes_in;         // 入站流量
        7  require long   bytes_out;        // 出站流量
        8  require long   udp_packets_in;   // 入站UDP包数
        9  require long   udp_packets_out;  // 出站UDP包数
        10 require long   errors;           // 错误数
    };

    // 创建端口转发统计信息 响应参数
    struct CreatePortForwardStatsResponse {
        1  require int    ret   = 0;       // 业务返回码（0 表示成功）
        2  require string msg  = "";        // 可选提示信息
    };

    // 开放服务接口
    interface OpenService {
        // 设备上报IP
        int ReportDeviceIP(ReportDeviceIPRequest req);

        // 获取设备端口转发
        int GetDevicePortForwards(GetDevicePortForwardsRequest req, out GetDevicePortForwardsResponse resp);

        // 创建端口转发统计信息
        int CreatePortForwardStats(CreatePortForwardStatsRequest req);
    };
};