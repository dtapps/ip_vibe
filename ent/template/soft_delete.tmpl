{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

import (
	"context"
	"time"
)

{{ range $n := $.Nodes }}
{{/* 检查实体是否包含 deleted_at 字段（snake_case 格式） */}}
{{ $hasSoftDelete := false }}
{{ range $f := $n.Fields }}
	{{ if eq $f.Name "deleted_at" }}
		{{ $hasSoftDelete = true }}
	{{ end }}
{{ end }}

{{ if $hasSoftDelete }}

// Delete 执行软删除操作，将 deleted_at 字段设置为当前时间。
// 该操作不会从数据库中物理删除记录，而是标记为已删除。
func (t *{{ $n.Name }}) Delete(ctx context.Context) error {
	return t.Update().SetDeletedAt(time.Now()).Exec(ctx)
}

// DeleteBulk 对当前查询匹配的所有记录执行批量软删除。
// 返回实际被更新（即标记为删除）的记录数量。
func (q *{{ $n.Name }}Query) DeleteBulk(ctx context.Context) (int, error) {
	return q.Update().SetDeletedAt(time.Now()).Exec(ctx)
}

// Query 返回一个已应用软删除过滤条件的新查询构造器。
// 默认仅返回 deleted_at 为 NULL 的记录（即未删除的记录）。
func (c *{{ $n.Name }}Client) Query() *{{ $n.Name }}Query {
	return c.Client.Query().Where({{ $n.Package }}.DeletedAtIsNil())
}

// WithDeleted 返回一个包含已软删除记录的查询（即不应用 deleted_at IS NULL 过滤）。
// 适用于管理后台、数据恢复等需要查看全部记录的场景。
func (q *{{ $n.Name }}Query) WithDeleted() *{{ $n.Name }}Query {
	// 注意：Ent 本身不追踪默认谓词，因此该方法假设调用者知晓上下文。
	// 实际使用中，建议直接从 Client 创建新查询并显式控制过滤条件。
	return q
}

{{ end }}
{{ end }}

