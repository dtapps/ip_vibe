// CountOrZero 统计总数 (失败返回 0)
func (q *{{ $n.Name }}Query) CountOrZero(ctx context.Context) (int64, error) {
	count, err := q.Count(ctx)
	if err != nil {
		return 0, err
	}
	return int64(count), nil
}

